# find and landed


def cmd_find(args):
    themes, people, projects = load_or_die()
    path = args.repo or os.getcwd()
    repo = main_checkout(path)
    if not repo:
        die(f"{path} is not in a git repo")
    branch = args.branch if args.branch is not None else current_branch(path)
    theme = theme_of_repo(themes, repo)
    hits = []
    for p in projects:
        if p.archived:
            continue
        for w in p.work:
            if w["repo"] == repo:
                by_branch = bool(branch and w["branch"] == branch)
                hits.append((0 if by_branch else 1, p, w))
    hits.sort(key=lambda h: h[0])
    print(f"repo {repo} · branch {branch or '-'} · theme {theme.key if theme else 'none in themes.md'}")
    shown = set()
    for rank, p, w in hits:
        if p.ident in shown:
            continue
        shown.add(p.ident)
        print(f"- {p.ident} ({'branch match' if rank == 0 else 'repo only'}; {p.state}): {p.front.get('title', '')}"
              f"{' · branch ' + w['branch'] if w['branch'] else ''}")
    if not hits:
        print("no project matches")


def fetch_age(repo):
    common = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()
    fh = os.path.join(common, "FETCH_HEAD")
    if not os.path.exists(fh):
        return "never fetched"
    hours = (time.time() - os.path.getmtime(fh)) / 3600
    return f"last fetch {hours:.0f}h ago" if hours < 48 else f"last fetch {hours / 24:.0f}d ago"


def pr_state(url):
    r = subprocess.run(["gh", "pr", "view", url, "--json", "state,reviewDecision,mergedAt"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None, (r.stderr.strip().splitlines() or ["gh failed"])[-1]
    d = json.loads(r.stdout)
    return d.get("state"), d.get("reviewDecision") or ""


def landed_check(repo, commit, branch, prs, resolve_branch=False):
    """('landed' | 'not landed' | 'unknown', [detail lines]). A branch stands in for a commit
    only in the ad hoc form (resolve_branch): a project's branch may be a reused home branch."""
    details = []
    if not os.path.isdir(repo):
        return "unknown", [f"repo {repo} does not exist"]
    details.append(fetch_age(repo))
    if not commit and branch and resolve_branch:
        for ref in (branch, f"origin/{branch}"):
            r = git(repo, "rev-parse", "--verify", "-q", f"{ref}^{{commit}}")
            if r.returncode == 0:
                commit = r.stdout.strip()
                details.append(f"branch {ref} is at {commit[:9]}")
                break
        else:
            details.append(f"branch {branch} not found locally or on origin")
    ancestry = None
    if commit:
        if git(repo, "cat-file", "-e", f"{commit}^{{commit}}").returncode != 0:
            details.append(f"commit {commit} is missing locally")
        else:
            trunks = [t for t in ("main", "master", "origin/main", "origin/master")
                      if git(repo, "rev-parse", "--verify", "-q", t).returncode == 0]
            inside = [t for t in trunks if git(repo, "merge-base", "--is-ancestor", commit, t).returncode == 0]
            ancestry = bool(inside) if trunks else None
            details.append(f"commit {commit[:9]} " + (f"is in {', '.join(inside)}" if inside
                                                         else f"is not in {', '.join(trunks) or 'any trunk'}"))
    else:
        details.append("no commit recorded")
    # Only the last PR on a Work line is the current chunk's; earlier ones are history.
    pr_merged, pr_known = False, True
    for n, url in enumerate(prs):
        current = n == len(prs) - 1
        st, extra = pr_state(url)
        label = f"PR {url}{'' if current else ' (earlier chunk)'}"
        if st is None:
            details.append(f"{label}: unknown ({extra})")
            pr_known = pr_known and not current
        else:
            details.append(f"{label}: {st}{' · ' + extra if extra else ''}")
            pr_merged = pr_merged or (current and st == "MERGED")
    if ancestry or pr_merged:
        return "landed", details
    if ancestry is False and pr_known:
        return "not landed", details
    if ancestry is None and prs and pr_known:
        return "not landed", details
    return "unknown", details


def cmd_landed(args):
    if args.repo:
        if not (args.commit or args.branch):
            die("landed --repo needs --commit or --branch")
        verdict, details = landed_check(realpath(args.repo), args.commit, args.branch, args.pr or [],
                                        resolve_branch=True)
        print(f"{verdict}: {args.repo} {args.commit or args.branch}")
        for d in details:
            print(f"      {d}")
        return
    themes, people, projects = load_or_die()
    chosen = [p for p in projects if not p.archived and (not args.projects or p.ident in args.projects)]
    missing = set(args.projects or []) - {p.ident for p in chosen}
    if missing:
        die(f"no such open project: {', '.join(sorted(missing))}")
    for p in chosen:
        if not p.work:
            print(f"{p.ident}: no Work lines")
            continue
        for w in p.work:
            verdict, details = landed_check(w["repo"], w["commit"], w["branch"], w["prs"])
            print(f"{p.ident}: {verdict} · {w['repo_text']}{' · ' + w['branch'] if w['branch'] else ''}")
            for d in details:
                print(f"      {d}")


# ---------------------------------------------------------------------------
# Claude Code sessions


TEXT_LIMIT = 600
TOOL_LIMIT = 160


def transcripts_dir():
    return os.path.join(CLAUDE_DIR, "projects")


def find_transcript(session_id):
    hits = glob.glob(os.path.join(transcripts_dir(), "*", f"{session_id}.jsonl"))
    if not hits:
        die(f"no transcript for session {session_id}")
    return hits[0]


def human_prompt(entry):
    """The text of a prompt Joi typed, or None."""
    if entry.get("type") != "user" or entry.get("isSidechain") or entry.get("isMeta"):
        return None
    origin = entry.get("origin") or {}
    if origin and origin.get("kind") != "human":
        return None
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, list):
        if any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
            return None
        content = " ".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    if not isinstance(content, str):
        return None
    text = content.strip()
    if not text or text.startswith(("<command-", "<local-command", "Caveat:", "<system-reminder>")):
        return None
    return text


def message_text(entry):
    """A transcript entry as short text, or None when it carries nothing to read."""
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, str):
        return content[:TEXT_LIMIT]
    if not isinstance(content, list):
        return None
    parts = []
    for block in content:
        if not isinstance(block, dict):
            continue
        kind = block.get("type")
        if kind == "text":
            parts.append(block.get("text", "")[:TEXT_LIMIT])
        elif kind == "tool_use":
            inp = block.get("input") or {}
            hint = inp.get("command") or inp.get("file_path") or inp.get("description") or ""
            parts.append(f"[tool {block.get('name')}: {str(hint)[:TOOL_LIMIT]}]")
        elif kind == "tool_result":
            body = block.get("content")
            if isinstance(body, list):
                body = " ".join(b.get("text", "") for b in body if isinstance(b, dict))
            parts.append(f"[result: {str(body or '')[:TOOL_LIMIT]}]")
    return "\n".join(p for p in parts if p) or None


def active_minutes(stamps):
    stamps = sorted(stamps)
    total = 0.0
    for a, b in zip(stamps, stamps[1:]):
        gap = (b - a).total_seconds() / 60
        if gap <= ACTIVE_GAP_MIN:
            total += gap
    return total


def scan_session(path):
    s = {"id": os.path.basename(path)[:-6], "path": path, "title": None, "cwds": [], "branches": [],
         "stamps": [], "prompts": []}
    with open(path) as f:
        for line in f:
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            kind = e.get("type")
            if kind == "ai-title":
                s["title"] = e.get("aiTitle")
                continue
            if kind not in ("user", "assistant") or e.get("isSidechain"):
                continue
            t = iso_ts(e.get("timestamp"))
            if t:
                s["stamps"].append(t)
            cwd, br = e.get("cwd"), e.get("gitBranch")
            if cwd and cwd not in s["cwds"]:
                s["cwds"].append(cwd)
            if br and br != "HEAD" and (not s["branches"] or s["branches"][-1] != br):
                s["branches"].append(br)
            p = human_prompt(e)
            if p:
                s["prompts"].append((t, p))
    return s


def dedupe(seq):
    out = []
    for x in seq:
        if x not in out:
            out.append(x)
    return out


def cmd_sessions(args):
    since = parse_time(args.since if " " in args.since or "T" in args.since else args.since + " 00:00")
    themes = load_themes() if os.path.exists(os.path.join(PROJECTS_DIR, "themes.md")) else {}
    repo = main_checkout(args.repo) if args.repo else None
    if args.repo and not repo:
        die(f"{args.repo} is not in a git repo")
    repo_cache = {}

    def repo_of(cwd):
        if cwd not in repo_cache:
            repo_cache[cwd] = main_checkout(cwd) if os.path.isdir(cwd) else None
        return repo_cache[cwd]

    rows = []
    for path in glob.glob(os.path.join(transcripts_dir(), "*", "*.jsonl")):
        if os.path.getmtime(path) < since.timestamp():
            continue
        s = scan_session(path)
        if not s["stamps"] or max(s["stamps"]) < since:
            continue
        repos = dedupe([r for r in (repo_of(c) for c in s["cwds"]) if r])
        if repo and repo not in repos:
            continue
        ts = dedupe([t.key for t in (theme_of_repo(themes, r) for r in repos) if t])
        rows.append((ts[0] if ts else "~none", min(s["stamps"]), s, repos, ts))
    rows.sort(key=lambda r: (r[0], r[1]))
    for theme, start, s, repos, ts in rows:
        end = max(s["stamps"])
        print(f"===== {s['id']} · theme {', '.join(ts) or 'none'} · {s['title'] or '(no title)'}")
        print(f"  transcript: {s['path']}")
        print(f"  when: {start.astimezone():%Y-%m-%d %H:%M} → {end.astimezone():%Y-%m-%d %H:%M} · "
              f"~{active_minutes(s['stamps']):.0f} min active · {len(s['prompts'])} prompts")
        print(f"  cwds: {', '.join(s['cwds'])}")
        print(f"  branches: {' → '.join(s['branches']) or '-'}")
        if s["prompts"]:
            print(f"  first prompt: {s['prompts'][0][1][:400]!r}")
            if len(s["prompts"]) > 1:
                print(f"  last prompt: {s['prompts'][-1][1][:400]!r}")
    print(f"\n{len(rows)} sessions since {since:%Y-%m-%d %H:%M}")


def cmd_tail(args):
    path = find_transcript(args.id)
    messages = []
    with open(path) as f:
        for line in f:
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            if e.get("type") not in ("user", "assistant") or e.get("isSidechain"):
                continue
            text = message_text(e)
            if text:
                messages.append((e.get("timestamp", ""), e["type"], text))
    print(f"===== session {args.id} ({path})")
    for stamp, role, text in messages[-args.n:]:
        print(f"--- {role} {stamp[:16]}")
        print(text)


def current_session_id():
    """The Claude Code session this process runs under: walk up the parent PIDs to one that
    ~/.claude/sessions/*.json knows."""
    by_pid = {}
    for path in glob.glob(os.path.join(CLAUDE_DIR, "sessions", "*.json")):
        try:
            with open(path) as f:
                d = json.load(f)
            by_pid[int(d["pid"])] = d["sessionId"]
        except (OSError, ValueError, KeyError, TypeError):
            continue
    pid = os.getpid()
    for _ in range(30):
        if pid in by_pid:
            return by_pid[pid]
        r = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True)
        try:
            pid = int(r.stdout.strip())
        except ValueError:
            return None
        if pid <= 1:
            return None
    return None


def cmd_session_time(args):
    sid = args.id or current_session_id()
    if not sid:
        die("cannot find the session this runs in; pass a session ID")
    s = scan_session(find_transcript(sid))
    stamps = s["stamps"]
    if args.since:
        since = parse_time(args.since)
        stamps = [t for t in stamps if t >= since]
    print(f"{active_minutes(stamps):.0f}")


# ---------------------------------------------------------------------------
# save


def git_dir():
    return os.path.join(PROJECTS_DIR, ".git")


def tracker_lock(timeout):
    """The lock that save and the SessionEnd hook share, or None after timeout seconds.
    Released when the process ends."""
    lock = open(os.path.join(git_dir(), "projects-save.lock"), "w")
    deadline = time.time() + timeout
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock
        except BlockingIOError:
            if time.time() > deadline:
                lock.close()
                return None
            time.sleep(0.2)


def cmd_save(args):
    if not os.path.isdir(git_dir()):
        die(f"{PROJECTS_DIR} is not a git repo")
    lock = tracker_lock(30)
    if lock is None:
        die("another save holds the lock for more than 30 seconds")
    files = []
    for f in args.files:
        a = os.path.abspath(os.path.join(PROJECTS_DIR, f) if not os.path.isabs(f) else f)
        if not a.startswith(PROJECTS_DIR + os.sep):
            die(f"{f} is not in {PROJECTS_DIR}")
        files.append(os.path.relpath(a, PROJECTS_DIR))
    themes, people, projects, errors = load_all()
    errors += validate(themes, people, projects)
    if errors:
        die("check failed, nothing saved:\n  " + "\n  ".join(errors))
    render(themes, projects, dt.date.today())
    r = git(PROJECTS_DIR, "add", "-A", "--", *files)
    if r.returncode != 0:
        die(f"git add failed: {r.stderr.strip()}")
    r = git(PROJECTS_DIR, "commit", "-q", "-m", args.message, "--", *files)
    if r.returncode != 0:
        if "nothing" in (r.stdout + r.stderr) and "commit" in (r.stdout + r.stderr):
            print("nothing to commit")
        else:
            die(f"git commit failed: {(r.stdout + r.stderr).strip()}")
    else:
        print(git(PROJECTS_DIR, "log", "-1", "--format=%h %s").stdout.strip())
    # Only a saved project file (or an explicit --resolves) counts as a handoff; saving
    # inbox.md or people.md does not.
    sid = current_session_id()
    saved_projects = {p.ident for p in projects if rel(p.path) in files}
    pend = read_jsonl(pending_path())
    resolved = set(args.resolves or []) | ({sid} if saved_projects else set())
    keep = [r for r in pend if r.get("session") not in resolved
            and r.get("project") not in saved_projects]
    # The sessions whose pending entries this save clears count as handed off too, so a
    # resumed session does not bring its old edits back as unhanded work.
    resolved |= {r.get("session") for r in pend if r not in keep}
    resolved.discard(None)
    # The current session is handed off only by saving a project or resolving itself;
    # resolving other sessions from here says nothing about this session's own work.
    own = sid if sid and (saved_projects or sid in resolved) else None
    resolved.discard(sid)
    if own or resolved:
        now = dt.datetime.now().astimezone().isoformat(timespec="seconds")
        with open(os.path.join(git_dir(), "projects-handoffs.jsonl"), "a") as f:
            f.write(json.dumps({"session": own, "at": now, "projects": sorted(saved_projects),
                                "resolves": sorted(resolved)}) + "\n")
    if len(keep) != len(pend):
        write_jsonl(pending_path(), keep)
        print(f"resolved {len(pend) - len(keep)} pending handoff(s)")


# ---------------------------------------------------------------------------
# Hooks. They never fail loudly: any error ends them silently with exit 0.


EDIT_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")


def is_work(block, tmp_prefixes):
    """Does an assistant tool_use block count as real work (outside ~/p/projects)?"""
    name = block.get("name")
    inp = block.get("input") or {}
    if name in EDIT_TOOLS:
        path = os.path.realpath(inp.get("file_path") or inp.get("notebook_path") or "")
        if not path or path.startswith(os.path.realpath(PROJECTS_DIR) + os.sep):
            return False
        return not any(path.startswith(t) for t in tmp_prefixes)
    if name == "Bash":
        cmd = inp.get("command") or ""
        return bool(re.search(r"\bgit\b[^|;&]*\bcommit\b", cmd)) and "projects save" not in cmd
    return False


def hook_state_path(session_id):
    d = os.path.join(git_dir(), "projects-hook")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, f"{session_id}.json")


def scan_incremental(transcript, state):
    """Read the transcript from the saved offset; update last work time, branches and the
    active minutes since the last nudge."""
    tmp_prefixes = [os.path.realpath("/tmp") + os.sep, os.path.realpath("/private/tmp") + os.sep]
    if state.get("offset", 0) > os.path.getsize(transcript):
        state.clear()
    with open(transcript, "rb") as f:
        f.seek(state.get("offset", 0))
        data = f.read()
    end = data.rfind(b"\n")
    if end < 0:
        return
    state["offset"] = state.get("offset", 0) + end + 1
    last = iso_ts(state.get("last_ts"))
    for raw in data[: end + 1].split(b"\n"):
        if not raw.strip():
            continue
        try:
            e = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if e.get("type") not in ("user", "assistant") or e.get("isSidechain"):
            continue
        t = iso_ts(e.get("timestamp"))
        br = e.get("gitBranch")
        if br and br != "HEAD" and br not in state.setdefault("branches", []):
            state["branches"].append(br)
        if t:
            if last and 0 <= (t - last).total_seconds() / 60 <= ACTIVE_GAP_MIN:
                state["active_since_nudge"] = state.get("active_since_nudge", 0) + (t - last).total_seconds() / 60
            last = t
            state["last_ts"] = t.isoformat()
        if e.get("type") == "assistant":
            content = (e.get("message") or {}).get("content")
            if isinstance(content, list):
                for b in content:
                    if isinstance(b, dict) and b.get("type") == "tool_use" and is_work(b, tmp_prefixes):
                        state["last_work"] = (t or dt.datetime.now().astimezone()).isoformat()


def last_handoff(session_id):
    times = [iso_ts(r.get("at")) for r in read_jsonl(os.path.join(git_dir(), "projects-handoffs.jsonl"))
             if r.get("session") == session_id or session_id in (r.get("resolves") or [])]
    times = [t for t in times if t]
    return max(times) if times else None


def project_for(themes, cwd, branches):
    """The one project whose Work line matches the repo and a branch the session was on;
    None when there is no match or more than one."""
    try:
        repo = main_checkout(cwd)
        _, _, projects, errors = load_all()
    except Exception:
        return None
    hits = {p.ident for p in projects if not p.archived for w in p.work
            if w["repo"] == repo and w["branch"] and w["branch"] in branches}
    return hits.pop() if len(hits) == 1 else None


def hook(event):
    if os.environ.get("PROJECTS_HOOKS", "").lower() == "off":
        return
    data = json.load(sys.stdin)
    session_id = data.get("session_id")
    transcript = data.get("transcript_path")
    cwd = data.get("cwd") or ""
    if not (session_id and transcript and os.path.exists(transcript) and os.path.isdir(git_dir())
            and os.path.exists(os.path.join(PROJECTS_DIR, "themes.md"))):
        return
    if os.path.realpath(cwd).startswith(os.path.realpath(PROJECTS_DIR)):
        return
    themes = load_themes()
    repo = main_checkout(cwd) if os.path.isdir(cwd) else None
    if not repo or not theme_of_repo(themes, repo):
        return
    spath = hook_state_path(session_id)
    state = {}
    if os.path.exists(spath):
        with open(spath) as f:
            state = json.load(f)
    scan_incremental(transcript, state)
    work = iso_ts(state.get("last_work"))
    handoff = last_handoff(session_id)
    unhanded = bool(work and (not handoff or handoff < work))
    out = None
    if event == "stop" and unhanded and not data.get("stop_hook_active"):
        nudged = state.get("nudged_at")
        if not nudged or state.get("active_since_nudge", 0) >= NUDGE_EVERY_MIN:
            state["nudged_at"] = dt.datetime.now().astimezone().isoformat()
            state["active_since_nudge"] = 0
            out = {"decision": "block", "reason": (
                "projects hook: this session changed files in a tracked theme's repo and has no "
                "project handoff since. If this work belongs to a project in ~/p/projects (or should "
                "become one) and we are at a natural stopping point, offer the handoff to Joi in one "
                "line (the projects skill says how). Otherwise do not mention this at all; just end "
                "your turn as you were going to.")}
    if event == "session-end" and unhanded:
        lock = tracker_lock(5)
        if lock is None:
            return
        handoff = last_handoff(session_id)      # a save may have resolved it while we waited
        if handoff and handoff >= work:
            return
        rows = [r for r in read_jsonl(pending_path()) if r.get("session") != session_id]
        rows.append({"session": session_id, "transcript": transcript, "cwd": cwd,
                     "branches": state.get("branches", []),
                     "project": project_for(themes, cwd, state.get("branches", [])),
                     "ended_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
                     "reason": data.get("reason")})
        write_jsonl(pending_path(), rows)
    with open(spath, "w") as f:
        json.dump(state, f)
    if out:
        print(json.dumps(out))


def cmd_hook(args):
    try:
        hook(args.event)
    except BaseException:   # SystemExit from die() too: a hook never fails loudly
        pass
    sys.exit(0)


# ---------------------------------------------------------------------------


def main():
    ap = argparse.ArgumentParser(prog="projects", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("render").set_defaults(fn=cmd_render)
    sub.add_parser("check").set_defaults(fn=cmd_check)
    p = sub.add_parser("next")
    p.add_argument("--date")
    p.add_argument("--nudges", action="store_true")
    p.set_defaults(fn=cmd_next)
    p = sub.add_parser("fit")
    p.add_argument("--minutes", type=int, required=True)
    p.add_argument("--attention", choices=ATTENTION)
    p.add_argument("--repo", action="append")
    p.add_argument("--no-worktree", action="store_true")
    p.add_argument("--limit", type=int, default=10)
    p.set_defaults(fn=cmd_fit)
    p = sub.add_parser("find")
    p.add_argument("--repo")
    p.add_argument("--branch")
    p.set_defaults(fn=cmd_find)
    p = sub.add_parser("landed")
    p.add_argument("projects", nargs="*")
    p.add_argument("--repo")
    p.add_argument("--commit")
    p.add_argument("--branch")
    p.add_argument("--pr", action="append")
    p.set_defaults(fn=cmd_landed)
    p = sub.add_parser("sessions")
    p.add_argument("--since", required=True)
    p.add_argument("--repo")
    p.set_defaults(fn=cmd_sessions)
    p = sub.add_parser("tail")
    p.add_argument("id")
    p.add_argument("-n", type=int, default=30)
    p.set_defaults(fn=cmd_tail)
    p = sub.add_parser("session-time")
    p.add_argument("id", nargs="?")
    p.add_argument("--since")
    p.set_defaults(fn=cmd_session_time)
    p = sub.add_parser("save")
    p.add_argument("-m", dest="message", required=True)
    p.add_argument("--resolves", action="append")
    p.add_argument("files", nargs="+")
    p.set_defaults(fn=cmd_save)
    p = sub.add_parser("hook")
    p.add_argument("event", choices=["stop", "session-end"])
    p.set_defaults(fn=cmd_hook)
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
