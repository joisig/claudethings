#!/usr/bin/env python3
"""projects - the tool behind the projects skill (Joi's project tracker in ~/p/projects).

  projects render                      Write overview.md and each theme's README.md
  projects check                       Parse and validate every project file
  projects next [--date D] [--nudges]  What is actionable, nudges due, deadlines, pending handoffs
  projects fit --minutes N [--attention A] [--repo PATH]... [--no-worktree] [--limit K]
                                       A ranked shortlist of items that fit the time
  projects find [--repo PATH] [--branch B]
                                       Projects whose Work lines match a repo (and branch)
  projects landed [theme/slug...]      Has the recorded work landed on main/master?
  projects landed --repo PATH (--commit SHA | --branch B) [--pr URL]
                                       The same, ad hoc, for work with no project file
  projects sessions --since D [--repo PATH]
                                       Claude Code sessions since D, with branches and prompts
  projects tail ID [-n COUNT]          The last messages of a session
  projects session-time [ID] [--since TIME]
                                       Active minutes of a session (default: this one)
  projects save -m MSG [--resolves ID]... FILE...
                                       check, render, then commit only FILE... in ~/p/projects
  projects hook stop|session-end       Claude Code hooks (read the hook JSON from stdin)

Standard library only. PROJECTS_DIR and PROJECTS_CLAUDE_DIR override ~/p/projects and
~/.claude (the tests use them). Every command except `hook` fails fast on a file that
does not parse.
"""

import argparse
import datetime as dt
import fcntl
import glob
import json
import os
import re
import subprocess
import sys
import tempfile
import time

PROJECTS_DIR = os.path.expanduser(os.environ.get("PROJECTS_DIR", "~/p/projects"))
CLAUDE_DIR = os.path.expanduser(os.environ.get("PROJECTS_CLAUDE_DIR", "~/.claude"))

SECTIONS = ["Goal", "Brief", "Work", "Waiting on others", "Ready for me", "Later",
            "Backlog", "Done", "Log", "Notes"]
ITEM_SECTIONS = ["Waiting on others", "Ready for me", "Later", "Done"]
OPEN_SECTIONS = ["Waiting on others", "Ready for me", "Later"]
ITEM_KEYS = ["Waiting", "Not before", "Due", "Size", "Needs", "Unblocks", "Thread", "PR",
             "How", "Then"]
FRONT_KEYS = {"title", "state", "reentry", "created", "touched"}
STATES = ["active", "paused", "done", "dropped"]
REENTRY_MINUTES = {"low": 5, "medium": 15, "high": 30}
REENTRY_LEVELS = ["low", "medium", "high"]
ATTENTION = ["shallow", "normal", "deep"]
STALE_DAYS = 21          # untouched longer than this: re-entry one level higher
ACTIVE_GAP_MIN = 15      # gaps longer than this do not count as active time
NUDGE_EVERY_MIN = 60     # Stop hook: at most one nudge per this much active time
GENERATED = "<!-- Generated by `projects render`. Do not edit; edit the project files. -->"

DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
HANDLE_RE = re.compile(r"@[a-z0-9][a-z0-9_-]*")
ITEM_RE = re.compile(r"^- \[( |x|X)\] (.+)$")
KEY_RE = re.compile(r"^\s+([A-Z][A-Za-z ]*?):\s*(.*)$")


class ParseError(Exception):
    pass


def die(msg):
    print(f"projects: {msg}", file=sys.stderr)
    sys.exit(1)


def parse_date(s, where):
    s = s.strip()
    if not DATE_RE.match(s):
        raise ParseError(f"{where}: not a date (YYYY-MM-DD): {s!r}")
    try:
        return dt.date.fromisoformat(s)
    except ValueError:
        raise ParseError(f"{where}: not a valid date: {s!r}")


def parse_time(s):
    """A local 'YYYY-MM-DD HH:MM', or an ISO timestamp (Z allowed), as an aware datetime."""
    s = s.strip().replace("Z", "+00:00")
    try:
        t = dt.datetime.fromisoformat(s)
    except ValueError:
        die(f"not a time: {s!r} (use 'YYYY-MM-DD HH:MM')")
    if t.tzinfo is None:
        t = t.astimezone()
    return t


def iso_ts(s):
    """A transcript timestamp as an aware datetime, or None."""
    if not s:
        return None
    try:
        return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def rel(path):
    return os.path.relpath(path, PROJECTS_DIR)


def realpath(p):
    return os.path.realpath(os.path.expanduser(p))


# ---------------------------------------------------------------------------
# themes.md and people.md


class Theme:
    def __init__(self, key, name):
        self.key = key
        self.name = name
        self.repos = []        # real paths of the repos' main checkouts
        self.delegation = False


def load_themes():
    path = os.path.join(PROJECTS_DIR, "themes.md")
    if not os.path.exists(path):
        die(f"no themes.md in {PROJECTS_DIR}")
    themes, cur = {}, None
    with open(path) as f:
        for n, line in enumerate(f, 1):
            line = line.rstrip("\n")
            m = re.match(r"^## ([a-z0-9-]+)(?: — (.+))?$", line)
            if m:
                cur = Theme(m.group(1), m.group(2) or m.group(1))
                themes[cur.key] = cur
                continue
            if line.startswith("## "):
                raise ParseError(f"themes.md:{n}: a theme heading is '## <folder> — <name>'")
            if cur is None:
                continue
            if line.startswith("Repos:"):
                cur.repos = [realpath(r.strip()) for r in line[6:].split(",") if r.strip()]
            elif line.startswith("Delegation:"):
                cur.delegation = line.split(":", 1)[1].strip().startswith("on")
    return themes


def load_people():
    """{handle: {"name", "emails", "github"}} from the '## @handle — Name' sections of people.md."""
    path = os.path.join(PROJECTS_DIR, "people.md")
    people = {"@joi": {"name": "Joi", "emails": [], "github": "joisig"}}
    if not os.path.exists(path):
        return people
    cur = None
    with open(path) as f:
        for line in f:
            m = re.match(r"^## (@[a-z0-9_-]+)(?: — (.+))?", line)
            if m:
                cur = {"name": (m.group(2) or "").strip(), "emails": [], "github": None}
                people[m.group(1)] = cur
                continue
            if cur is None:
                continue
            m = re.match(r"^- Email:\s*(.+)", line)
            if m:
                cur["emails"] += re.findall(r"[\w.+-]+@[\w.-]+\.\w+", m.group(1))
            m = re.match(r"^- GitHub:\s*(\S+)", line)
            if m:
                cur["github"] = m.group(1)
    return people


# ---------------------------------------------------------------------------
# Git helpers


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)


def main_checkout(path):
    """The main checkout of the repo that path is in (worktrees resolve to it), or None."""
    r = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if r.returncode != 0:
        return None
    common = r.stdout.strip()
    return os.path.realpath(os.path.dirname(common) if common.endswith(".git") else common)


def current_branch(path):
    r = git(path, "symbolic-ref", "--short", "-q", "HEAD")
    return r.stdout.strip() or None


def theme_of_repo(themes, repo_main):
    for t in themes.values():
        if repo_main in t.repos:
            return t
    return None


# ---------------------------------------------------------------------------
# Project files


class Item:
    def __init__(self, section, checked, text, line):
        self.section = section
        self.checked = checked
        self.text = text
        self.line = line
        self.keys = {}
        self.key_indent = 0
        # parsed values
        self.waiting = None      # {"handles", "since", "nudge"}
        self.not_before = None   # ("date", date) | ("after", theme/slug, text or None) | ("text", s)
        self.due = None
        self.size = None         # {"minutes", "attention", "where", "repo", "branch", "extras"}
        self.unblocks = []


class Project:
    def __init__(self, path, theme, slug, archived):
        self.path = path
        self.theme = theme
        self.slug = slug
        self.archived = archived
        self.front = {}
        self.sections = {}       # name -> list of (line number, text)
        self.items = []
        self.work = []           # {"repo", "branch", "commit", "prs", "line"}
        self.log = []            # (datetime or None, text)

    @property
    def ident(self):
        return f"{self.theme}/{self.slug}"

    @property
    def state(self):
        return self.front.get("state", "active")

    def open_items(self):
        return [i for i in self.items if i.section in OPEN_SECTIONS and not i.checked]


def project_files(include_archive=True):
    """(path, theme, slug, archived) for every project file."""
    out = []
    roots = [(PROJECTS_DIR, False)]
    if include_archive:
        roots.append((os.path.join(PROJECTS_DIR, "archive"), True))
    for root, archived in roots:
        for theme_dir in sorted(glob.glob(os.path.join(root, "*"))):
            theme = os.path.basename(theme_dir)
            if not os.path.isdir(theme_dir) or theme in ("archive", "drafts") or theme.startswith("."):
                continue
            for p in sorted(glob.glob(os.path.join(theme_dir, "*.md"))):
                if os.path.basename(p) != "README.md":
                    out.append((p, theme, os.path.basename(p)[:-3], archived))
            for p in sorted(glob.glob(os.path.join(theme_dir, "*", "README.md"))):
                out.append((p, theme, os.path.basename(os.path.dirname(p)), archived))
    return out


def parse_project(path, theme, slug, archived):
    p = Project(path, theme, slug, archived)
    where = rel(path)
    with open(path) as f:
        lines = f.read().split("\n")
    i = 0
    if lines and lines[0].strip() == "---":
        i = 1
        while i < len(lines) and lines[i].strip() != "---":
            raw = lines[i].split("#", 1)[0].strip()
            if raw:
                if ":" not in raw:
                    raise ParseError(f"{where}:{i + 1}: frontmatter line is not 'key: value'")
                k, v = raw.split(":", 1)
                p.front[k.strip()] = v.strip()
            i += 1
        if i >= len(lines):
            raise ParseError(f"{where}: frontmatter is not closed with '---'")
        i += 1
    else:
        raise ParseError(f"{where}:1: a project file starts with '---' frontmatter")

    section = None
    item = None
    last_key = None
    for n in range(i, len(lines)):
        line = lines[n]
        ln = n + 1
        if line.startswith("# "):
            continue
        if line.startswith("## "):
            section = line[3:].strip()
            if section not in SECTIONS:
                raise ParseError(f"{where}:{ln}: unknown section {section!r} (known: {', '.join(SECTIONS)})")
            p.sections.setdefault(section, [])
            item, last_key = None, None
            continue
        if section is None:
            if line.strip():
                raise ParseError(f"{where}:{ln}: text before the first '## ' section")
            continue
        p.sections[section].append((ln, line))
        if section in ITEM_SECTIONS:
            if not line.strip():
                continue
            m = ITEM_RE.match(line)
            if m:
                item = Item(section, m.group(1) != " ", m.group(2).strip(), ln)
                p.items.append(item)
                last_key = None
                continue
            if item is None or not line.startswith(" "):
                raise ParseError(f"{where}:{ln}: in '{section}', expected '- [ ] item' or an indented 'Key: value' line")
            # Key lines share one indent; a line indented deeper continues the previous key.
            indent = len(line) - len(line.lstrip(" "))
            if last_key is not None and indent > item.key_indent:
                item.keys[last_key] += " " + line.strip()
                continue
            km = KEY_RE.match(line)
            if not km or km.group(1) not in ITEM_KEYS:
                raise ParseError(f"{where}:{ln}: expected 'Key: value' with a known key "
                                 f"({', '.join(ITEM_KEYS)}), or a continuation indented deeper: {line.strip()!r}")
            last_key = km.group(1)
            if last_key in item.keys:
                raise ParseError(f"{where}:{ln}: key {last_key!r} given twice")
            item.key_indent = indent
            item.keys[last_key] = km.group(2).strip()
        elif section == "Work" and line.strip():
            if not line.startswith("- "):
                raise ParseError(f"{where}:{ln}: a Work line is '- <repo> · branch B · commit SHA · PR URL'")
            p.work.append(parse_work(line[2:], f"{where}:{ln}", ln))
        elif section == "Log" and line.startswith("- "):
            m = re.match(r"^- (\d{4}-\d{2}-\d{2})(?: (\d{2}:\d{2}))?", line)
            stamp = None
            if m:
                stamp = parse_time(f"{m.group(1)} {m.group(2) or '00:00'}")
            p.log.append((stamp, line[2:]))
    for it in p.items:
        parse_item_values(it, f"{where}:{it.line}")
    return p


def parse_work(text, where, ln):
    parts = [s.strip() for s in text.split("·")]
    w = {"repo": realpath(parts[0]), "repo_text": parts[0], "branch": None, "commit": None,
         "prs": [], "line": ln}
    for part in parts[1:]:
        if part.startswith("branch "):
            w["branch"] = part[7:].strip()
        elif part.startswith("commit "):
            w["commit"] = part[7:].strip()
            if not re.match(r"^[0-9a-f]{7,40}$", w["commit"]):
                raise ParseError(f"{where}: commit is not a SHA: {w['commit']!r}")
        elif part.startswith("PR "):
            url = part[3:].strip()
            if not url.startswith("https://"):
                raise ParseError(f"{where}: a PR is a full URL: {url!r}")
            w["prs"].append(url)
        elif part:
            raise ParseError(f"{where}: unknown Work part {part!r}")
    return w


def parse_item_values(it, where):
    k = it.keys
    if "Waiting" in k:
        v = k["Waiting"]
        handles = HANDLE_RE.findall(v.split(" since ")[0])
        since = re.search(r"since (\d{4}-\d{2}-\d{2})", v)
        nudge = re.search(r"nudge (\d{4}-\d{2}-\d{2})", v)
        if not handles or not since:
            raise ParseError(f"{where}: Waiting is '@handle[, @handle] since YYYY-MM-DD [· nudge YYYY-MM-DD]'")
        it.waiting = {"handles": handles, "since": parse_date(since.group(1), where),
                      "nudge": parse_date(nudge.group(1), where) if nudge else None}
    if "Not before" in k:
        v = k["Not before"].strip()
        if DATE_RE.match(v):
            it.not_before = ("date", parse_date(v, where))
        elif v.startswith("after "):
            m = re.match(r"^after ([a-z0-9-]+/[a-z0-9._-]+)(?::\s*(.+))?$", v)
            if not m:
                raise ParseError(f"{where}: 'Not before: after <theme>/<slug>[: <start of item text>]'")
            it.not_before = ("after", m.group(1), m.group(2))
        else:
            it.not_before = ("text", v)
    if "Due" in k:
        it.due = parse_date(k["Due"], where)
    if "Size" in k:
        it.size = parse_size(k["Size"], where)
    if "Unblocks" in k:
        it.unblocks = HANDLE_RE.findall(k["Unblocks"])


def parse_size(v, where):
    parts = [s.strip() for s in v.split("·")]
    if len(parts) < 3:
        raise ParseError(f"{where}: Size is '<N> min · <deep|normal|shallow> · <where>'")
    m = re.match(r"^(\d+)\s*(min|h)$", parts[0])
    if not m:
        raise ParseError(f"{where}: Size minutes are '<N> min' or '<N> h': {parts[0]!r}")
    minutes = int(m.group(1)) * (60 if m.group(2) == "h" else 1)
    if parts[1] not in ATTENTION:
        raise ParseError(f"{where}: Size attention is one of {ATTENTION}: {parts[1]!r}")
    place = parts[2]
    size = {"minutes": minutes, "attention": parts[1], "where": place, "repo": None,
            "branch": None, "extras": parts[3:]}
    if place != "no worktree":
        m = re.match(r"^(.+?), (any worktree|branch (\S+))$", place)
        if not m:
            raise ParseError(f"{where}: Size place is 'no worktree', '<repo>, any worktree' or '<repo>, branch <name>'")
        size["repo"] = m.group(1)
        size["branch"] = m.group(3)
    for e in size["extras"]:
        if e not in ("dev server", "prod"):
            raise ParseError(f"{where}: Size extra is 'dev server' or 'prod': {e!r}")
    return size


def load_all():
    themes = load_themes()
    people = load_people()
    projects = []
    errors = []
    for path, theme, slug, archived in project_files():
        try:
            projects.append(parse_project(path, theme, slug, archived))
        except ParseError as e:
            errors.append(str(e))
    return themes, people, projects, errors


def load_or_die():
    try:
        themes, people, projects, errors = load_all()
    except ParseError as e:
        die(str(e))
    if errors:
        die("files do not parse:\n  " + "\n  ".join(errors))
    return themes, people, projects


# ---------------------------------------------------------------------------
# Derived values


def find_ref(projects, ident, text):
    """(project, item) that a 'Not before: after' reference points at. Raises ParseError when
    it matches nothing or more than one item."""
    matches = [p for p in projects if p.ident == ident]
    if len(matches) != 1:
        raise ParseError(f"no project {ident}" if not matches else f"{ident} exists twice (archive and live?)")
    proj = matches[0]
    if text is None:
        return proj, None
    items = [i for i in proj.items if i.text.startswith(text)]
    if len(items) != 1:
        raise ParseError(f"{len(items)} items in {ident} start with {text!r}")
    return proj, items[0]


def not_before_met(item, projects, today):
    nb = item.not_before
    if nb is None:
        return True
    if nb[0] == "date":
        return nb[1] <= today
    if nb[0] == "after":
        try:
            proj, it = find_ref(projects, nb[1], nb[2])
        except ParseError:
            return False
        return it.checked if it else proj.state == "done"
    return False


def actionable(item, projects, today):
    """An item that Joi can act on now."""
    if item.checked or item.waiting or item.section not in ("Ready for me", "Later"):
        return False
    return not_before_met(item, projects, today)


def status(p, projects, today):
    if p.state != "active":
        return p.state
    items = p.open_items()
    if not items:
        return "idle"
    if any(actionable(i, projects, today) for i in items):
        return "ready"
    return "waiting"


def next_date(p):
    dates = []
    for i in p.open_items():
        if i.not_before and i.not_before[0] == "date":
            dates.append(i.not_before[1])
        if i.waiting and i.waiting["nudge"]:
            dates.append(i.waiting["nudge"])
        if i.due:
            dates.append(i.due)
    return min(dates) if dates else None


def ball(p):
    hs = []
    for i in p.open_items():
        if i.waiting:
            hs += [h for h in i.waiting["handles"] if h not in hs]
    return hs


def touched(p):
    try:
        return dt.date.fromisoformat(p.front.get("touched", ""))
    except ValueError:
        return None


def reentry_minutes(p, today):
    level = p.front.get("reentry", "medium")
    idx = REENTRY_LEVELS.index(level) if level in REENTRY_LEVELS else 1
    t = touched(p)
    if t and (today - t).days > STALE_DAYS:
        idx = min(idx + 1, 2)
    return REENTRY_MINUTES[REENTRY_LEVELS[idx]]


def repo_matches(size_repo, wanted, themes):
    """Does an item's Size repo (a path or a repo's folder name) match a --repo argument?"""
    a = size_repo
    known = [r for t in themes.values() for r in t.repos]
    cand = {realpath(a)} | {r for r in known if os.path.basename(r) == a}
    w = main_checkout(wanted) or realpath(wanted)
    return w in cand or os.path.basename(w) == a


# ---------------------------------------------------------------------------
# check


def validate(themes, people, projects):
    errors = []
    for t in themes:
        if not os.path.isdir(os.path.join(PROJECTS_DIR, t)):
            errors.append(f"themes.md: theme {t} has no folder")
    seen = {}
    for p in projects:
        where = rel(p.path)
        if p.ident in seen:
            errors.append(f"{where}: {p.ident} also exists at {rel(seen[p.ident])}")
        seen[p.ident] = p.path
        if p.theme not in themes:
            errors.append(f"{where}: theme folder {p.theme!r} is not in themes.md")
        for k in p.front:
            if k not in FRONT_KEYS:
                errors.append(f"{where}: unknown frontmatter key {k!r}")
        if "title" not in p.front:
            errors.append(f"{where}: frontmatter has no title")
        if p.front.get("state") not in STATES:
            errors.append(f"{where}: state is one of {STATES}")
        if p.archived and p.state not in ("done", "dropped"):
            errors.append(f"{where}: archived, but state is {p.state}")
        if not p.archived and p.state in ("done", "dropped"):
            errors.append(f"{where}: state is {p.state}; move it to archive/{p.theme}/")
        if p.front.get("reentry", "medium") not in REENTRY_LEVELS:
            errors.append(f"{where}: reentry is one of {REENTRY_LEVELS}")
        for k in ("created", "touched"):
            try:
                parse_date(p.front.get(k, ""), f"{where}: {k}")
            except ParseError as e:
                errors.append(str(e))
        for it in p.items:
            iw = f"{where}:{it.line}"
            if it.section == "Waiting on others" and not it.waiting and not it.checked:
                errors.append(f"{iw}: an item in 'Waiting on others' needs 'Waiting:'")
            if it.section == "Later" and not it.not_before and not it.checked:
                errors.append(f"{iw}: an item in 'Later' needs 'Not before:'")
            if it.section == "Done" and not it.checked:
                errors.append(f"{iw}: an item in 'Done' is checked '- [x]'")
            handles = []
            if it.waiting:
                handles += it.waiting["handles"]
            handles += it.unblocks
            handles += HANDLE_RE.findall(it.keys.get("Needs", ""))
            for h in handles:
                if h not in people:
                    errors.append(f"{iw}: unknown handle {h} (not in people.md)")
            if it.not_before and it.not_before[0] == "after":
                try:
                    find_ref(projects, it.not_before[1], it.not_before[2])
                except ParseError as e:
                    errors.append(f"{iw}: Not before: {e}")
    return errors


def cmd_check(args):
    themes, people, projects, errors = load_all()
    errors += validate(themes, people, projects)
    if errors:
        die("check failed:\n  " + "\n  ".join(errors))
    print(f"ok: {len(projects)} projects")


# ---------------------------------------------------------------------------
# render


def item_line(it, p, projects, today):
    bits = []
    if it.waiting:
        bits.append(f"waiting {', '.join(it.waiting['handles'])} since {it.waiting['since']}")
    if it.not_before:
        nb = it.not_before
        if nb[0] == "date":
            bits.append(f"not before {nb[1]}" if nb[1] > today else f"ready since {nb[1]}")
        elif nb[0] == "after":
            met = not_before_met(it, projects, today)
            bits.append(("met: " if met else "after ") + nb[1] + (f": {nb[2]}" if nb[2] else ""))
        else:
            bits.append(f"not before: {nb[1]}")
    if it.size:
        bits.append(f"{it.size['minutes']} min {it.size['attention']}")
    return it.text + (f" ({'; '.join(bits)})" if bits else "")


def first_next(p, projects, today):
    """The item to show as the project's next step."""
    items = p.open_items()
    for it in items:
        if actionable(it, projects, today):
            return it
    for it in items:
        if it.waiting:
            return it
    return items[0] if items else None


def render(themes, projects, today):
    live = [p for p in projects if not p.archived]
    order = {"ready": 0, "waiting": 1, "idle": 2, "paused": 3}
    overview = [GENERATED, "", f"# Overview ({today})", ""]
    for key, theme in themes.items():
        ps = sorted([p for p in live if p.theme == key],
                    key=lambda p: (order.get(status(p, projects, today), 9), next_date(p) or dt.date.max))
        archived = [p for p in projects if p.archived and p.theme == key]
        lines = [GENERATED, "", f"# {theme.name}", ""]
        if not ps:
            lines.append("No open projects.")
        else:
            lines += ["| Project | Status | Next | When | With |", "|---|---|---|---|---|"]
            for p in ps:
                st = status(p, projects, today)
                nx = first_next(p, projects, today)
                nd = next_date(p)
                link = os.path.relpath(p.path, os.path.join(PROJECTS_DIR, key))
                cells = [f"[{p.front.get('title', p.slug)}]({link})", st,
                         (item_line(nx, p, projects, today) if nx else "").replace("|", "\\|"),
                         str(nd) if nd else "", ", ".join(ball(p))]
                lines.append("| " + " | ".join(cells) + " |")
        if archived:
            lines += ["", f"{len(archived)} done or dropped in archive/{key}/."]
        with open(os.path.join(PROJECTS_DIR, key, "README.md"), "w") as f:
            f.write("\n".join(lines) + "\n")
        if ps:
            overview += [f"## {theme.name}", ""]
            for p in ps:
                st = status(p, projects, today)
                nx = first_next(p, projects, today)
                nd = next_date(p)
                with_ = f" · with {', '.join(ball(p))}" if ball(p) else ""
                when = f" · {nd}" if nd else ""
                overview.append(f"- **{p.ident}** ({st}{when}{with_}): {item_line(nx, p, projects, today) if nx else '—'}")
            overview.append("")
    with open(os.path.join(PROJECTS_DIR, "overview.md"), "w") as f:
        f.write("\n".join(overview) + "\n")


def cmd_render(args):
    themes, people, projects = load_or_die()
    render(themes, projects, dt.date.today())
    print(f"rendered overview.md and {len(themes)} theme READMEs")


# ---------------------------------------------------------------------------
# next and fit


def pending_path():
    return os.path.join(PROJECTS_DIR, "pending-handoffs.jsonl")


def read_jsonl(path):
    out = []
    if os.path.exists(path):
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        out.append(json.loads(line))
                    except json.JSONDecodeError:
                        continue
    return out


def write_jsonl(path, rows):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    with os.fdopen(fd, "w") as f:
        for r in rows:
            f.write(json.dumps(r) + "\n")
    os.replace(tmp, path)


def show_item(p, it, extra=""):
    print(f"- {p.ident}: {it.text}{extra}")
    for k in ITEM_KEYS:
        if k in it.keys:
            print(f"      {k}: {it.keys[k]}")


def cmd_next(args):
    themes, people, projects = load_or_die()
    today = dt.date.fromisoformat(args.date) if args.date else dt.date.today()
    live = [p for p in projects if not p.archived and p.state == "active"]

    nudges = [(p, i) for p in live for i in p.open_items()
              if i.waiting and i.waiting["nudge"] and i.waiting["nudge"] <= today]
    print(f"## Nudges due ({today})")
    for p, i in nudges or []:
        show_item(p, i)
    if not nudges:
        print("none")
    if args.nudges:
        return

    print("\n## Ready for Joi now")
    ready = [(p, i) for p in live for i in p.open_items() if actionable(i, projects, today)]
    for p, i in ready:
        became = ""
        if i.section == "Later":
            became = "  [was in Later; its Not before is met]"
        show_item(p, i, became)
    if not ready:
        print("none")

    print("\n## Due within 7 days")
    due = [(p, i) for p in live for i in p.open_items() if i.due and i.due <= today + dt.timedelta(days=7)]
    for p, i in sorted(due, key=lambda x: x[1].due):
        show_item(p, i, f"  [due {i.due}]")
    if not due:
        print("none")

    deleg = [t.key for t in themes.values() if t.delegation]
    if deleg:
        print(f"\n## On Joi in delegation themes ({', '.join(deleg)}) — judge which could go to someone else")
        mine = [(p, i) for p in live if p.theme in deleg for i in p.open_items() if not i.waiting]
        for p, i in mine:
            show_item(p, i)
        if not mine:
            print("none")

    pend = read_jsonl(pending_path())
    print("\n## Sessions that ended without a handoff")
    for r in pend:
        print(f"- {r.get('ended_at', '?')[:16]} {r.get('session')} in {r.get('cwd')} "
              f"(branches {', '.join(r.get('branches') or []) or '?'}; project {r.get('project') or 'none matched'})")
        print(f"      transcript: {r.get('transcript')}")
    if not pend:
        print("none")


def cmd_fit(args):
    themes, people, projects = load_or_die()
    today = dt.date.today()
    max_att = ATTENTION.index(args.attention) if args.attention else 2
    cands, unsized = [], 0
    for p in projects:
        if p.archived or p.state != "active":
            continue
        for it in p.open_items():
            if not actionable(it, projects, today):
                continue
            if not it.size:
                unsized += 1
                continue
            s = it.size
            if ATTENTION.index(s["attention"]) > max_att:
                continue
            if args.no_worktree and s["repo"]:
                continue
            if args.repo and s["repo"] and not any(repo_matches(s["repo"], r, themes) for r in args.repo):
                continue
            total = s["minutes"] + reentry_minutes(p, today)
            if total > args.minutes:
                continue
            met_days = 0
            if it.not_before and it.not_before[0] == "date":
                met_days = (today - it.not_before[1]).days
            t = touched(p) or dt.date.min
            cands.append(((0 if it.unblocks else 1, -met_days, -t.toordinal()), p, it, total))
    cands.sort(key=lambda c: c[0])
    print(f"# Fits in {args.minutes} min (item minutes + re-entry)")
    for _, p, it, total in cands[: args.limit]:
        s = it.size
        why = []
        if it.unblocks:
            why.append(f"unblocks {', '.join(it.unblocks)}")
        if it.not_before and it.not_before[0] == "date":
            why.append(f"ready since {it.not_before[1]}")
        t = touched(p)
        if t:
            why.append(f"touched {t}")
        print(f"- {total} min ({s['minutes']} + {total - s['minutes']} re-entry) · {s['attention']} · "
              f"{s['where']}{''.join(' · ' + e for e in s['extras'])}")
        print(f"      {p.ident}: {it.text}")
        print(f"      {'; '.join(why)}")
    if not cands:
        print("nothing fits")
    if unsized:
        print(f"\n({unsized} actionable items have no Size: line and were not considered)")


